{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberrange.invalid/schemas/lab.schema.json",
  "title": "Cyber Range lab manifest",
  "type": "object",
  "required": ["slug", "title", "summary", "category", "difficulty", "estimated_minutes", "version", "objectives", "questions"],
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 3},
    "summary": {"type": "string", "minLength": 10},
    "category": {"type": "string", "minLength": 2},
    "difficulty": {"enum": ["beginner", "intermediate", "advanced"]},
    "estimated_minutes": {"type": "integer", "minimum": 5, "maximum": 600},
    "version": {"type": "integer", "minimum": 1},
    "objectives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "questions": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/question"}}
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": ["id", "type", "prompt", "points", "explanation"],
      "properties": {
        "id": {"type": "string"},
        "type": {"enum": ["mcq", "short_text", "numeric", "flag", "check"]},
        "prompt": {"type": "string", "minLength": 10},
        "points": {"type": "integer", "minimum": 1},
        "options": {"type": "array", "items": {}},
        "answer": {},
        "accepted": {"type": "array"},
        "regex": {"type": "array", "items": {"type": "string"}},
        "tolerance": {"type": "number", "minimum": 0},
        "check": {"type": "object", "required": ["target", "command"], "properties": {"target": {"type": "string"}, "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "stdout_contains": {"type": "string"}, "exit_code": {"type": "integer"}, "timeout": {"type": "integer", "minimum": 1, "maximum": 30}}, "additionalProperties": false},
        "explanation": {"type": "string"},
        "hints": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
