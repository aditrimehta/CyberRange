# Copy this file to .env and replace the secrets before production.
# Runtime: fake is the default for UI/API development; docker launches isolated lab containers.
APP_ENV=development
RUNTIME=fake

# Database credentials are internal to the compose network; do not publish port 5432.
POSTGRES_DB=cyberrange
POSTGRES_USER=cyberrange
POSTGRES_PASSWORD=development-db-password-change-me

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=development-only-change-me-32-chars
SECURE_COOKIES=false

# Limits and session cleanup defaults.
MAX_ACTIVE_SESSIONS=40
MAX_SESSIONS_PER_USER=1
DEFAULT_IDLE_MINUTES=30
DEFAULT_MAX_DURATION_MINUTES=180
# Set true only after enabling policy-approved session extension.
ALLOW_SESSION_EXTENSION=false

# Set true only after SMTP delivery has been configured and a verification flow is deployed.
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
FRONTEND_ORIGIN=http://localhost

# Production hostname and ACME email; used by docker-compose.prod.yml.
DOMAIN=range.example.edu
ACME_EMAIL=it@example.edu
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0
